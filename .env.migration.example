# MySQL 8 source (read-only account recommended outside disposable rehearsals)
MIGRATION_MYSQL_HOST=127.0.0.1
MIGRATION_MYSQL_PORT=3306
MIGRATION_MYSQL_USER=asin_migration_reader
MIGRATION_MYSQL_PASSWORD=replace_with_source_password
MIGRATION_MYSQL_PRIMARY_DATABASE=amazon_asin_monitor
MIGRATION_MYSQL_COMPETITOR_DATABASE=amazon_competitor_monitor

# PostgreSQL 16 / TimescaleDB targets. Keep primary and competitor databases distinct.
DATABASE_URL=postgresql://postgres:replace_with_target_password@127.0.0.1:5432/amazon_asin_monitor
COMPETITOR_DATABASE_URL=postgresql://postgres:replace_with_target_password@127.0.0.1:5432/amazon_competitor_monitor

# Target tables are truncated only when this explicit guard is true.
MIGRATION_ALLOW_TARGET_RESET=false
MIGRATION_BATCH_SIZE=500
MIGRATION_SAMPLE_SIZE=20
MIGRATION_REPORT_PATH=artifacts/data-migration/report.json
LOG_LEVEL=INFO
