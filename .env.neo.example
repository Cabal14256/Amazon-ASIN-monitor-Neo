# Neo Nest API / BullMQ Worker 环境模板
# 复制为根目录 .env.neo。旧 Express 继续读取 server/.env，两者可并行运行。

NODE_ENV=development
LOG_LEVEL=INFO
PORT=3100
CORS_ORIGIN=http://localhost:8000

# PostgreSQL 16+ / TimescaleDB：主营与竞品使用两个独立 database。
# 下列 NEO_POSTGRES_* 仅供 compose.neo.yml 本地开发使用；生产必须改用强密码/密钥管理。
TIMESCALEDB_IMAGE=timescale/timescaledb:2.29.2-pg16
NEO_POSTGRES_USER=postgres
NEO_POSTGRES_PASSWORD=neo_dev_only
NEO_POSTGRES_PORT=5432
NEO_POSTGRES_DATABASE=amazon_asin_monitor
NEO_COMPETITOR_DATABASE=amazon_competitor_monitor
DATABASE_URL=postgresql://postgres:neo_dev_only@127.0.0.1:5432/amazon_asin_monitor
COMPETITOR_DATABASE_URL=postgresql://postgres:neo_dev_only@127.0.0.1:5432/amazon_competitor_monitor

# P1-T4a CAGG 对拍窗口。仅运行 db:timescale:aggregate:gate 时需要；
# 使用 Asia/Shanghai 本地月初边界，end 为排他边界。
# TIMESCALE_AGG_WINDOW_START=2026-01-01 00:00:00
# TIMESCALE_AGG_WINDOW_END=2026-02-01 00:00:00
# Must remain true for promotion evidence; false is diagnostic-only and exits nonzero.
# TIMESCALE_AGG_REFRESH=true
# TIMESCALE_AGG_PAGE_SIZE=1000
# TIMESCALE_AGG_REPORT_PATH=artifacts/timescale-aggregate/report.json

# Redis 首选完整 URL；也兼容 REDIS_URI 或下方分项变量。
REDIS_URL=redis://127.0.0.1:6379
# REDIS_URI=redis://127.0.0.1:6379
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_USERNAME=
# REDIS_PASSWORD=
# REDIS_DB=0
BULL_PREFIX=bull

JWT_SECRET=replace_with_a_long_random_secret
SCHEDULER_ENABLED=false
WORKER_ENABLED_QUEUES=all
