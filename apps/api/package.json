{
  "name": "@asin-monitor/api",
  "version": "0.0.0",
  "private": true,
  "description": "新后端：NestJS 11（Fastify adapter）HTTP + WS 网关 + 调度",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "tsx watch src/main.ts",
    "test": "corepack pnpm --filter @asin-monitor/db... build && vitest run",
    "typecheck": "tsc -p tsconfig.build.json --noEmit"
  },
  "dependencies": {
    "@asin-monitor/config": "workspace:*",
    "@asin-monitor/contracts": "workspace:*",
    "@asin-monitor/db": "workspace:*",
    "@fastify/cookie": "10.0.1",
    "@nestjs/common": "^11.1.3",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.3",
    "@nestjs/platform-fastify": "^11.1.3",
    "fastify": "5.11.3",
    "ioredis": "^5.8.2",
    "jsonwebtoken": "9.0.2",
    "mysql2": "3.15.3",
    "pg": "^8.16.3",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.3",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.15.4",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20"
  }
}
