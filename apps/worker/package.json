{
  "name": "@asin-monitor/worker",
  "version": "0.0.0",
  "private": true,
  "description": "BullMQ 消费进程（对应旧 PROCESS_ROLE=worker），与 api 共享领域模块",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "tsx watch src/main.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.build.json --noEmit"
  },
  "dependencies": {
    "@asin-monitor/config": "workspace:*",
    "@asin-monitor/contracts": "workspace:*",
    "bullmq": "^5.58.0",
    "ioredis": "^5.8.2",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20"
  }
}
