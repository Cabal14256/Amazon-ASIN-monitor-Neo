# Phase 0 双系统并行验证片段。
# 旧业务流量继续走 3001；Neo 骨架通过 /neo-api/ 暴露 3100，避免提前接管 /api/v1。
# 合并到实际 server 块前请替换域名、TLS、静态目录与访问控制。

location /api/ {
    proxy_pass http://127.0.0.1:3001;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    # 保持 Legacy 长分析请求的现有行为，不回退到 Nginx 默认 60 秒。
    proxy_connect_timeout 1200s;
    proxy_send_timeout 1200s;
    proxy_read_timeout 1200s;
}

location /ws {
    proxy_pass http://127.0.0.1:3001/ws;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header Host $host;

    # 保持 Legacy 长连接行为，避免浏览器心跳被节流时按默认 60 秒断开。
    proxy_connect_timeout 7d;
    proxy_send_timeout 7d;
    proxy_read_timeout 7d;
}

# /neo-api/health -> Neo /health
# /neo-api/api/v1/health -> Neo /api/v1/health
# /neo-api/metrics -> Neo /metrics（生产环境应限制访问）
location /neo-api/ {
    rewrite ^/neo-api/(.*)$ /$1 break;
    proxy_pass http://127.0.0.1:3100;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
}
