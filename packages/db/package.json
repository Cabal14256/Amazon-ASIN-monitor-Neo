{
  "name": "@asin-monitor/db",
  "version": "0.0.0",
  "private": true,
  "description": "Drizzle ORM schema（PG）+ drizzle-kit 迁移（双 database：主库 + 竞品库）",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:generate:competitor": "drizzle-kit generate --config drizzle.competitor.config.ts",
    "test": "vitest run --exclude test/environment.integration.test.ts",
    "test:integration": "corepack pnpm --filter @asin-monitor/config build && vitest run test/environment.integration.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "drizzle-orm": "^0.44.2",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@asin-monitor/config": "workspace:*",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.15.4",
    "drizzle-kit": "^0.31.4",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20"
  }
}
