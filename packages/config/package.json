{
  "name": "@asin-monitor/config",
  "version": "0.0.0",
  "private": true,
  "description": "共享环境变量校验（zod），对齐旧系统 envValidator 语义",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "dist/index.js",
