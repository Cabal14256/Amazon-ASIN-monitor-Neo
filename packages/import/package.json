{
  "name": "@asin-monitor/import",
  "version": "0.0.0",
  "private": true,
  "description": "API/Worker 共享的流式文件导入与行校验",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "corepack pnpm --filter @asin-monitor/import... build && vitest run",
    "typecheck": "tsc -p tsconfig.test.json --noEmit"
  },
  "dependencies": {
    "@asin-monitor/db": "workspace:*",
    "dayjs": "1.11.19",
    "exceljs": "4.4.0",
    "fast-csv": "4.3.6",
    "iconv-lite": "0.4.24",
    "saxes": "5.0.1",
    "yauzl": "3.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/yauzl": "3.4.0",
    "jszip": "3.10.1",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20"
  }
}
